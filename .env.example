# 複製為 .env 後填入實際值；兩者皆為必填，未設定程式會拒絕啟動
SECRET_KEY=
DB_ADMIN_PASSWORD=

# 選填
# uv 本機執行時使用；Docker 保留預設 0.0.0.0
# HOST=127.0.0.1
# PORT=5001

# Server Docker Compose 必填；已盤點；舊 dashboard 移轉完成後沿用 5001，其他 server 仍須自行確認
COMPOSE_PROJECT_NAME=proj-dashboard
DASHBOARD_PORT=5001

# Server 使用 genton 的實際 UID/GID，讓 bind mount 資料可寫
# UID=1000
# GID=1000
